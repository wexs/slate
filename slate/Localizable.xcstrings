    },
    "close_on_focus_lost_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, clicking outside the translation card hides the window. When disabled, stays on top."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al activarlo, hacer clic fuera de la tarjeta oculta la ventana. Al desactivarlo, permanece visible encima."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, un clic en dehors de la carte masque la fenêtre. Sinon, elle reste au premier plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、翻訳カード外をクリックした際に自動で非表示になります。無効時は最前面に固定されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 번역 카드 외부를 클릭할 때 창이 자동으로 숨겨집니다. 비활성화하면 항상 위에 고정됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При включении клик вне карточки перевода скроет окно. При выключении окно останется поверх всех окон."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，鼠标点击翻译卡片之外的区域窗口会自动隐藏。关闭后窗口保持置顶展示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟後，滑鼠點擊翻譯卡片之外的區域視窗會自動隱藏。關閉後視窗保持置頂展示。"
          }
        }
      }
    },
