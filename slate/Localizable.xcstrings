    "google_speech_mode_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Text-to-Speech works out-of-the-box for free without any API key. If you have a Google Cloud account and want higher rate limits, you can enter your Cloud Text-to-Speech API key below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Text-to-Speech funciona de forma gratuita sin necesidad de clave API. Si tienes una cuenta de Google Cloud y deseas límites más altos, puedes introducir tu clave API de Cloud Text-to-Speech a continuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Text-to-Speech est utilisable gratuitement sans clé API. Si vous disposez d’un compte Google Cloud et souhaitez des quotas plus élevés, saisissez votre clé Cloud Text-to-Speech ci-dessous."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 音声合成は API キーなしで無料ですぐに利用できます。Google Cloud アカウントをお持ちで、より高いクォータや高音質を利用したい場合は、Cloud Text-to-Speech API キーを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 음성 합성은 API 키 없이도 즉시 무료로 작동합니다. Google Cloud 계정이 있고 더 높은 한도와 고음질을 원하시면 Cloud Text-to-Speech API 키를 입력하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Синтез речи работает бесплатно из коробки без API-ключа. Если у вас есть аккаунт Google Cloud для повышенных лимитов, введите ваш ключ Cloud Text-to-Speech API."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 语音开箱即用，无需配置 API 密钥即可直接发音。如果您有 Google Cloud 账号并希望获得更高的调用配额与自定义音质，可填入 Cloud Text-to-Speech API 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 語音隨開即用，無需設定 API 金鑰即可直接朗讀。如果您有 Google Cloud 帳號並希望取得更高的呼叫配額與自訂音質，可填入 Cloud Text-to-Speech API 金鑰。"
          }
        }
      }
    },
