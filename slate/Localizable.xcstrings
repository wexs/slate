    "smart_line_break_merge_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically merge soft line breaks within paragraphs to prevent awkward line breaks and extra blank lines (preserves paragraphs and lists)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combina automáticamente saltos de línea suaves para evitar saltos y líneas vacías (conserva párrafos y listas)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusionne automatiquement les retours à la ligne dus à la mise en page afin d’éviter les coupures maladroites et les lignes vides superflues (les paragraphes et les listes sont conservés)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "段落内の不自然な改行を自動で結合し、不要な空行を防止（空行の段落やリストは保持）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문단 내 불필요한 줄바꿈을 자동 병합하여 여분의 빈 줄 방지 (빈 줄 문단 및 목록 유지)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически объединять переносы строк в абзацах для предотвращения лишних пустых строк (сохраняет абзацы и списки)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动合并段落内因排版产生的单行断句，消除译文多余空行（保留空行段落与列表）"
          }
        },
        "zh-Hant" : {
