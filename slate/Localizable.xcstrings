        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플로팅 번역 카드의 너비를 조정합니다. 표준은 컴팩트하고 넓은 너비는 긴 글에 적합합니다"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройка ширины плавающей карточки перевода: стандартная — компактная, широкая — для длинных текстов"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整翻译悬浮卡片的展开宽度，标准尺寸小巧精致，较宽适合长文"
          }
        },
        "zh-Hant" : {
