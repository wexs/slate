            "value" : "Selection translation relies on macOS Accessibility permission to read your selected text automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La traducción de selección requiere permisos de accesibilidad de macOS para leer el texto seleccionado."
