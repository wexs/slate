    "system_form_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built-in high-speed online translation channel, ready out of the box without configuring any API keys or downloading offline language packs. Supports automatic language detection with millisecond response time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canal de traducción en línea de alta velocidad integrado, listo para usar sin configurar claves API ni descargar paquetes de idiomas. Admite detección automática de idiomas y respuesta rápida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service de traduction en ligne rapide, prêt à l’emploi sans clé API ni téléchargement de modèles. Détection automatique de la langue et réponses en quelques millisecondes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高速オンライン翻訳チャネルを内蔵し、APIキーの設定や言語パックのダウンロードなしですぐに使用できます。多言語の自動検出とミリ秒単位の高速応答をサポートします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고속 온라인 번역 채널이 내장되어 있어 API 키 설정이나 오프라인 언어 팩 다운로드 없이 바로 사용할 수 있습니다. 다국어 자동 감지 및 밀리초 단위 초고속 응답을 지원합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встроенный высокоскоростной онлайн-перевод, готовый к работе без настройки API-ключей и скачивания языковых пакетов. Автоматическое определение языка и мгновенный ответ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内置高速在线翻译通道，开箱即用，无需配置任何 API 密钥或下载离线语言包。支持多语言自动检测与毫秒级快速响应。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "內建高速線上翻譯通道，開箱即用，無需設定任何 API 金鑰或下載離線語言套件。支援多語言自動偵測與毫秒級快速回應。"
          }
        }
      }
    },
