    "alibaba_form_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtain AccessKey ID and AccessKey Secret in Alibaba Cloud RAM console and enable Machine Translation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtén AccessKey ID y Secret en Alibaba Cloud RAM y activa el servicio de traducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenez les clés AccessKey ID et AccessKey Secret dans la console RAM d’Alibaba Cloud, puis activez la traduction automatique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alibaba Cloud RAM コンソールで AccessKey ID と Secret を取得し、翻訳サービスを有効化してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알리바바 클라우드 RAM 콘솔에서 AccessKey ID와 Secret을 생성하고 번역 서비스를 활성화하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получите AccessKey ID и Secret в консоли Alibaba Cloud RAM и подключите машинный перевод."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在阿里云 RAM 控制台获取 AccessKey ID 与 AccessKey Secret，并开通机器翻译通用版。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在阿里雲 RAM 主控台取得 AccessKey ID 與 AccessKey Secret，並開通機器翻譯通用版。"
          }
        }
      }
    },
