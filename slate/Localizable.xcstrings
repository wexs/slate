          }
        }
      }
    },
    "shortcut_tip_2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Selection translation uses macOS Accessibility API without intruding into other apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• La traducción de selección utiliza la API de Accesibilidad de macOS de forma segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• La traduction de sélection utilise l’API d’accessibilité macOS sans intervenir dans les autres apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 選択翻訳は macOS アクセシビリティ API を使用し、安全に動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 선택 번역은 macOS 손쉬운 사용 API를 통해 안전하게 동작합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Перевод выделенного использует API macOS без вмешательства в другие программы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 划词翻译通过 macOS 辅助功能 API 模拟读取，不侵入其他软件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 劃詞翻譯透過 macOS 輔助功能 API 模擬讀取，不侵入其他軟體。"
          }
        }
      }
    },
    "shortcut_tip_3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Screen OCR runs entirely offline on Apple Neural Engine, keeping your data private."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• El OCR de captura se ejecuta sin conexión en el Neural Engine, protegiendo tu privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• La reconnaissance OCR s’effectue entièrement hors ligne sur le Neural Engine Apple pour préserver la confidentialité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 画面OCRはApple Neural Engineにより端末内で完全にオフライン処理され、プライバシーを守ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 화면 OCR은 Apple Neural Engine을 통해 기기 내에서 오프라인으로 처리되어 안전합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Распознавание скриншотов выполняется локально через Neural Engine, защищая вашу приватность."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 截图识别全程在设备本地神经引擎中离线完成，保护屏幕隐私。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 截圖辨識全程在裝置本機神經引擎中離線完成，保護螢幕隱私。"
          }
        }
      }
    },
