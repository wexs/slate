    "launch_at_login_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically launch quietly in the background when logging into macOS, ready to summon via shortcut"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar automáticamente en segundo plano al iniciar sesión en macOS para responder al atajo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancer Slate discrètement en arrière-plan à l’ouverture de session macOS, prêt à être affiché avec le raccourci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSログイン時にバックグラウンドで自動起動し、いつでもショートカットで呼び出せます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 로그인 시 백그라운드에서 자동으로 조용히 시작되어 단축키에 즉시 반응합니다"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматический тихий запуск в фоне при входе в macOS для мгновенного вызова по горячим клавишам"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开机并登录 macOS 时自动在后台静默启动，随时响应快捷键呼出"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開機並登入 macOS 時自動在後台靜默啟動，隨時響應快捷鍵呼出"
          }
        }
      }
    },
