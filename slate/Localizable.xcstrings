    "google_form_mode_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Free Mode: Leave blank to use the free Google Web channel directly.\n• API Key Mode: Enter your Google Cloud Translation API Key for higher quotas and stability."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Modo gratuito: Déjalo en blanco para usar el canal web de Google.\n• Modo clave API: Ingresa tu Google Cloud Translation API Key para cuotas mayores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Mode gratuit : laissez le champ vide pour utiliser directement le service Web gratuit de Google.\n• Mode avec clé API : saisissez votre clé Google Cloud Translation pour augmenter les quotas et la stabilité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• キー不要モード：空白のままでGoogle無料Webチャンネルを素早く利用できます。\n• 専用キーモード：大規模な呼び出しには Google Cloud Translation API キーを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 무료 모드: 비워두면 Google 무료 웹 번역 채널을 즉시 사용합니다.\n• 전용 키 모드: 대량 호출 또는 안정성을 위해 Google Cloud Translation API Key를 입력하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Бесплатный режим: оставьте пустым для использования веб-канала Google.\n• Режим API-ключа: введите ключ Google Cloud Translation для больших объемов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 免密钥模式：留空即可直接使用 Google 免费网页翻译通道，极速便捷。\n• 私有密钥模式：如需大规模调用或防止频控，可填入 Google Cloud Translation API Key。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 免金鑰模式：留空即可直接使用 Google 免費網頁翻譯通道，極速便捷。\n• 私有金鑰模式：如需大規模調用或防止頻控，可填入 Google Cloud Translation API Key。"
          }
        }
      }
    },
