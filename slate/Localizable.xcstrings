    "clear_on_open_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, summoning the window clears previous input and translation for a fresh start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al activarlo, cada vez que abras la ventana se borrará el contenido anterior para empezar de cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, la fenêtre s’ouvre avec un champ et une traduction vides."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、ウィンドウを開くたびに前回の内容が消去され、新規入力状態になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 창을 열 때마다 이전 내용이 지워지고 새로운 입력 상태로 시작됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При включении каждый вызов окна очищает предыдущий ввод и перевод для нового начала."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，每次呼出或打开窗口均自动清空上次的输入与译文，直接进入全新的无内容输入状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟後，每次呼出或打開視窗均自動清空上次的輸入與譯文，直接進入全新的無內容輸入狀態。"
          }
        }
      }
    },
