      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust floating card width. Standard is compact, Wide is suitable for long text"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el ancho de la tarjeta flotante: estándar es compacta, ancha es ideal para textos largos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez la largeur de la carte flottante. Le format standard est compact ; le format large convient aux longs textes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻訳フローティングカードの幅を調整します。標準はコンパクト、ワイドは長文に適しています"
