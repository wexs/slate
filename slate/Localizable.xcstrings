    "deepl_form_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supports DeepL API Free (usually ends with :fx) and DeepL API Pro. Endpoints are matched automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatible con DeepL API Free (suele terminar en :fx) y DeepL API Pro. Se conecta automáticamente al endpoint oficial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatible avec DeepL API Free (la clé se termine généralement par :fx) et DeepL API Pro. Le point de terminaison est choisi automatiquement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepL API Free（末尾が :fx）と DeepL API Pro の両方に対応し、適切なエンドポイントに自動接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
